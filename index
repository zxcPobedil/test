  </div>
  <div class="modal-actions">
    <button class="btn" onclick="closeModal()">GOT IT</button>
  </div>`);

/* ============================================================
   INIT
   ============================================================ */
(function init(){
  renderBoard();
  const loaded = loadGame();
  if(loaded){
    renderPlayers();
    log("💾 Saved game restored.");
  } else {
    renderPlayers();
  }
})();
</script>
